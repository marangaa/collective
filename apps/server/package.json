{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "seed": "bun run ../../packages/api/src/seed/run.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@collective/api": "workspace:*",
    "@collective/db": "workspace:*",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "catalog:",
    "better-auth": "^1.7.5",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.7",

    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@collective/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
