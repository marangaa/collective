# Copy to .env and fill in. See README "Install and configure".
NODE_ENV=development

# Browser origin allowed by CORS + Better Auth. Local web runs on :3001.
CORS_ORIGIN=http://localhost:3001

# Neon/PostgreSQL connection string (pooled URL for the API,
# direct/unpooled URL for migrations). Required.
DATABASE_URL=

# 32+ char secret. Required in production, optional for local dev.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Promoted to reviewer on first magic-link sign-in. Needed for /review.
REVIEWER_EMAIL=

# Optional. Only needed for pipeline extraction (packages/pipeline).
GEMINI_API_KEY=

# Optional. Only needed for real photo uploads (R2). Reports still
# queue offline and submit text-only when unconfigured.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
